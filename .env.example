NODE_ENV=development
PORT=3000

POSTGRES_DB=prolific
POSTGRES_USER=prolific
POSTGRES_PASSWORD=prolific_local_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://prolific:prolific_local_only@localhost:5432/prolific?schema=public
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

OAUTH_ISSUER=https://identity.example.test/
OAUTH_AUDIENCE=prolific-core-api
OAUTH_PUBLIC_KEY_PEM_BASE64=base64_encoded_rs256_public_key_pem
OAUTH_CLOCK_TOLERANCE_SECONDS=60

LOCAL_AUTH_JWT_SECRET=change_me_to_a_long_secret_in_production
LOCAL_AUTH_ACCESS_TOKEN_EXPIRY_SECONDS=900
LOCAL_AUTH_REFRESH_TOKEN_EXPIRY_DAYS=30
